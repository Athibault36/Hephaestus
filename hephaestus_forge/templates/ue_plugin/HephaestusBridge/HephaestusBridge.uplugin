[PluginSettings]
PluginName=HephaestusBridge
PluginDescription="HEPHAESTUS Agent Bridge - Total Engine Authority for UE5.8 Autonomous Agent"
PluginVersion=1.0.0
PluginCategory=Hephaestus
CreatedBy=HephaestusForge
CreatedByURL=https://github.com/hephaestus-forge
DocsURL=https://github.com/hephaestus-forge/docs
MarketplaceURL=
SupportURL=
CanContainContent=True
IsBetaVersion=False
IsExperimentalVersion=False
Installed=False

[Modules]
+Module=(Name="HephaestusBridge", Type="Runtime", LoadingPhase="Default")
+Module=(Name="HephaestusBridgeEditor", Type="Editor", LoadingPhase="PostEngineInit")

[Platforms]
+Platforms=Win64
+Platforms=Linux
+Platforms=Mac

