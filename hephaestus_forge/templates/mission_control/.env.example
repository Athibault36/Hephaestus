# Mission Control — copy to .env and adjust ports to match .hephaestus_forge/config.yaml

# Socket.IO bridge (forge agent --stream)
VITE_BRIDGE_URL=http://127.0.0.1:8081

# UE HephaestusBridge HTTP server (viewport frame polling uses /ue-bridge proxy in dev)
VITE_UE_BRIDGE_URL=/ue-bridge
VITE_UE_BRIDGE_PROXY=http://127.0.0.1:8099

# Optional shared token (must match security.bridge_token in config.yaml)
# VITE_UE_BRIDGE_TOKEN=

# Viewport poll interval in ms (capture_frame -> GET /frame/:id)
VITE_FRAME_POLL_MS=2000
