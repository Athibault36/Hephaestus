# Copy to .env (gitignored) and fill in values.
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE
HEPHAESTUS_PLANNER_VISION=1
# Optional:
# HEPHAESTUS_VISION_MODEL=microsoft/phi-3.5-vision-instruct
# UE_PATH=C:\Program Files\Epic Games\UE_5.8
# Character Creator 5 (people path):
# CC5_EXECUTABLE=C:\Program Files\Reallusion\Character Creator 5\Character Creator 5\Bin64\CharacterCreator.exe
# RLPYTHON=C:\Program Files\Reallusion\Character Creator 5\Character Creator 5\Bin64\CharacterCreatorpy.exe
# Generative people/creatures via Meshy (optional paid — off by default):
# HEPHAESTUS_USE_MESHY=1
# MESHY_API_KEY=msy_YOUR_KEY_HERE
